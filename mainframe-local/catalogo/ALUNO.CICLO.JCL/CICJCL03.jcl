//CICJCL03 JOB ,'CICLO DO CARTAO',NOTIFY=&SYSUID,
//             CLASS=A,MSGCLASS=X
//*--------------------------------------------------------------------
//* AULA 3 - COMPENSACAO (CICCLEAR) E LIQUIDACAO (CICLIQUI)
//*   STEP005  APAGA AS SAIDAS ANTERIORES
//*   STEP010  ORDENA O LOG DE AUTORIZACOES POR CARTAO E CODIGO
//*   STEP020  JUNTA E ORDENA OS ARQUIVOS DE CLEARING DAS BANDEIRAS
//*            (HEADERS PRIMEIRO, DEPOIS OS DETALHES, TRAILERS NO FIM)
//*   STEP030  CASAMENTO E LANCAMENTOS (CICCLEAR)
//*   STEP040  ORDENA OS LANCAMENTOS POR BANDEIRA E IRD
//*   STEP050  LIQUIDACAO POR BANDEIRA (CICLIQUI) - DESAFIO DA AULA 3
//* PRE-REQUISITO: O CICJCL02 JA RODOU (CICLO.AUTH.LOG EXISTE).
//*--------------------------------------------------------------------
//STEP005  EXEC PGM=IEFBR14
//LOGORD   DD DSN=&SYSUID..CICLO.AUTH.LOG.ORDEN,DISP=(MOD,DELETE),
//            SPACE=(TRK,(1,1)),RECFM=FB,LRECL=120
//CLRORD   DD DSN=&SYSUID..CICLO.CLEAR.ORDEN,DISP=(MOD,DELETE),
//            SPACE=(TRK,(1,1)),RECFM=FB,LRECL=80
//LANCANT  DD DSN=&SYSUID..CICLO.LANCAM,DISP=(MOD,DELETE),
//            SPACE=(TRK,(1,1)),RECFM=FB,LRECL=120
//FATANT   DD DSN=&SYSUID..CICLO.FATTRANS,DISP=(MOD,DELETE),
//            SPACE=(TRK,(1,1)),RECFM=FB,LRECL=80
//EXCANT   DD DSN=&SYSUID..CICLO.EXCECAO,DISP=(MOD,DELETE),
//            SPACE=(TRK,(1,1)),RECFM=FB,LRECL=120
//LANORD   DD DSN=&SYSUID..CICLO.LANCAM.BANDEIRA,DISP=(MOD,DELETE),
//            SPACE=(TRK,(1,1)),RECFM=FB,LRECL=120
//LIQANT   DD DSN=&SYSUID..CICLO.LIQUIDA,DISP=(MOD,DELETE),
//            SPACE=(TRK,(1,1)),RECFM=FBA,LRECL=133
//*
//STEP010  EXEC PGM=SORT
//SYSOUT   DD SYSOUT=*
//SORTIN   DD DSN=&SYSUID..CICLO.AUTH.LOG,DISP=SHR
//SORTOUT  DD DSN=&SYSUID..CICLO.AUTH.LOG.ORDEN,
//            DISP=(NEW,CATLG,DELETE),
//            SPACE=(TRK,(2,1),RLSE),RECFM=FB,LRECL=120,BLKSIZE=0
//SYSIN    DD *
  SORT FIELDS=(15,16,CH,A,74,6,CH,A)
/*
//*
//STEP020  EXEC PGM=SORT
//SYSOUT   DD SYSOUT=*
//SORTIN   DD DSN=&SYSUID..CICLO.CLEAR.ALFA,DISP=SHR
//         DD DSN=&SYSUID..CICLO.CLEAR.BETA,DISP=SHR
//SORTOUT  DD DSN=&SYSUID..CICLO.CLEAR.ORDEN,
//            DISP=(NEW,CATLG,DELETE),
//            SPACE=(TRK,(2,1),RLSE),RECFM=FB,LRECL=80,BLKSIZE=0
//SYSIN    DD *
  SORT FIELDS=(1,1,CH,A,2,16,CH,A,18,6,CH,A,24,12,CH,A)
/*
//*
// IF (STEP010.RC = 0 AND STEP020.RC = 0) THEN
//STEP030  EXEC PGM=CICCLEAR
//STEPLIB  DD DSN=&SYSUID..CICLO.LOAD,DISP=SHR
//AUTLOGIN DD DSN=&SYSUID..CICLO.AUTH.LOG.ORDEN,DISP=SHR
//CLEARIN  DD DSN=&SYSUID..CICLO.CLEAR.ORDEN,DISP=SHR
//LANCOUT  DD DSN=&SYSUID..CICLO.LANCAM,
//            DISP=(NEW,CATLG,DELETE),
//            SPACE=(TRK,(2,1),RLSE),RECFM=FB,LRECL=120,BLKSIZE=0
//FATOUT   DD DSN=&SYSUID..CICLO.FATTRANS,
//            DISP=(NEW,CATLG,DELETE),
//            SPACE=(TRK,(2,1),RLSE),RECFM=FB,LRECL=80,BLKSIZE=0
//EXCECOUT DD DSN=&SYSUID..CICLO.EXCECAO,
//            DISP=(NEW,CATLG,DELETE),
//            SPACE=(TRK,(1,1),RLSE),RECFM=FB,LRECL=120,BLKSIZE=0
//SYSOUT   DD SYSOUT=*
//CEEDUMP  DD SYSOUT=*
// ENDIF
//*
// IF (STEP030.RC <= 4) THEN
//STEP040  EXEC PGM=SORT
//SYSOUT   DD SYSOUT=*
//SORTIN   DD DSN=&SYSUID..CICLO.LANCAM,DISP=SHR
//SORTOUT  DD DSN=&SYSUID..CICLO.LANCAM.BANDEIRA,
//            DISP=(NEW,CATLG,DELETE),
//            SPACE=(TRK,(2,1),RLSE),RECFM=FB,LRECL=120,BLKSIZE=0
//SYSIN    DD *
  SORT FIELDS=(80,1,CH,A,78,2,CH,A,1,16,CH,A)
/*
// ENDIF
//*
// IF (STEP040.RC = 0) THEN
//STEP050  EXEC PGM=CICLIQUI
//STEPLIB  DD DSN=&SYSUID..CICLO.LOAD,DISP=SHR
//LANCIN   DD DSN=&SYSUID..CICLO.LANCAM.BANDEIRA,DISP=SHR
//IRDTAB   DD DSN=&SYSUID..CICLO.IRD.TABELA,DISP=SHR
//LIQUIOUT DD DSN=&SYSUID..CICLO.LIQUIDA,
//            DISP=(NEW,CATLG,DELETE),
//            SPACE=(TRK,(2,1),RLSE),RECFM=FBA,LRECL=133,BLKSIZE=0
//SYSOUT   DD SYSOUT=*
//CEEDUMP  DD SYSOUT=*
// ENDIF
