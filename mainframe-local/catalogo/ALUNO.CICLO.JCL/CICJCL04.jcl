//CICJCL04 JOB ,'CICLO DO CARTAO',NOTIFY=&SYSUID,
//             CLASS=A,MSGCLASS=X
//*--------------------------------------------------------------------
//* AULA 4 - ANALISE DAS CONTESTACOES E CHARGEBACK (CICDISPU)
//*   STEP005  APAGA AS SAIDAS ANTERIORES
//*   STEP010  ORDENA OS LANCAMENTOS PELA REFERENCIA (RRN)
//*   STEP020  ORDENA AS CONTESTACOES PELA REFERENCIA (RRN)
//*   STEP030  ANALISE, CHARGEBACKS E CREDITOS PROVISORIOS
//* PRE-REQUISITO: O CICJCL03 JA RODOU (CICLO.LANCAM EXISTE).
//* A DATA DE MOVIMENTO FICA NO DATASET CICLO.DATA.MOVTO.
//*--------------------------------------------------------------------
//STEP005  EXEC PGM=IEFBR14
//LANORD   DD DSN=&SYSUID..CICLO.LANCAM.RRN,DISP=(MOD,DELETE),
//            SPACE=(TRK,(1,1)),RECFM=FB,LRECL=120
//CONORD   DD DSN=&SYSUID..CICLO.CONTEST.ORDEN,DISP=(MOD,DELETE),
//            SPACE=(TRK,(1,1)),RECFM=FB,LRECL=80
//CHBANT   DD DSN=&SYSUID..CICLO.CHARGEB,DISP=(MOD,DELETE),
//            SPACE=(TRK,(1,1)),RECFM=FB,LRECL=120
//AJUANT   DD DSN=&SYSUID..CICLO.AJUSTES,DISP=(MOD,DELETE),
//            SPACE=(TRK,(1,1)),RECFM=FB,LRECL=80
//RELANT   DD DSN=&SYSUID..CICLO.RELDISP,DISP=(MOD,DELETE),
//            SPACE=(TRK,(1,1)),RECFM=FBA,LRECL=133
//*
//STEP010  EXEC PGM=SORT
//SYSOUT   DD SYSOUT=*
//SORTIN   DD DSN=&SYSUID..CICLO.LANCAM,DISP=SHR
//SORTOUT  DD DSN=&SYSUID..CICLO.LANCAM.RRN,
//            DISP=(NEW,CATLG,DELETE),
//            SPACE=(TRK,(2,1),RLSE),RECFM=FB,LRECL=120,BLKSIZE=0
//SYSIN    DD *
  SORT FIELDS=(23,12,CH,A)
/*
//*
//STEP020  EXEC PGM=SORT
//SYSOUT   DD SYSOUT=*
//SORTIN   DD DSN=&SYSUID..CICLO.CONTEST,DISP=SHR
//SORTOUT  DD DSN=&SYSUID..CICLO.CONTEST.ORDEN,
//            DISP=(NEW,CATLG,DELETE),
//            SPACE=(TRK,(1,1),RLSE),RECFM=FB,LRECL=80,BLKSIZE=0
//SYSIN    DD *
  SORT FIELDS=(17,12,CH,A,50,10,CH,A)
/*
//*
// IF (STEP010.RC = 0 AND STEP020.RC = 0) THEN
//STEP030  EXEC PGM=CICDISPU
//STEPLIB  DD DSN=&SYSUID..CICLO.LOAD,DISP=SHR
//CONTIN   DD DSN=&SYSUID..CICLO.CONTEST.ORDEN,DISP=SHR
//LANCIN   DD DSN=&SYSUID..CICLO.LANCAM.RRN,DISP=SHR
//DATAIN   DD DSN=&SYSUID..CICLO.DATA.MOVTO,DISP=SHR
//CHARGOUT DD DSN=&SYSUID..CICLO.CHARGEB,
//            DISP=(NEW,CATLG,DELETE),
//            SPACE=(TRK,(1,1),RLSE),RECFM=FB,LRECL=120,BLKSIZE=0
//AJUSOUT  DD DSN=&SYSUID..CICLO.AJUSTES,
//            DISP=(NEW,CATLG,DELETE),
//            SPACE=(TRK,(1,1),RLSE),RECFM=FB,LRECL=80,BLKSIZE=0
//RELDOUT  DD DSN=&SYSUID..CICLO.RELDISP,
//            DISP=(NEW,CATLG,DELETE),
//            SPACE=(TRK,(1,1),RLSE),RECFM=FBA,LRECL=133,BLKSIZE=0
//SYSOUT   DD SYSOUT=*
//CEEDUMP  DD SYSOUT=*
// ENDIF
