//CICJCL01 JOB ,'CICLO DO CARTAO',NOTIFY=&SYSUID,
//             CLASS=A,MSGCLASS=X
//*--------------------------------------------------------------------
//* AULA 1 - IDENTIFICACAO PELO BIN E DIVISAO DO VALOR (CICBIN)
//* PODE SER SUBMETIDO VARIAS VEZES: O STEP005 APAGA O RELATORIO.
//*--------------------------------------------------------------------
//STEP005  EXEC PGM=IEFBR14
//RELANT   DD DSN=&SYSUID..CICLO.RELBIN,DISP=(MOD,DELETE),
//            SPACE=(TRK,(1,1)),RECFM=FBA,LRECL=133
//*
//STEP010  EXEC PGM=CICBIN
//STEPLIB  DD DSN=&SYSUID..CICLO.LOAD,DISP=SHR
//BINTAB   DD DSN=&SYSUID..CICLO.BIN.TABELA,DISP=SHR
//PEDIDOS  DD DSN=&SYSUID..CICLO.AUTH.PEDIDOS,DISP=SHR
//RELBIN   DD DSN=&SYSUID..CICLO.RELBIN,
//            DISP=(NEW,CATLG,DELETE),
//            SPACE=(TRK,(2,1),RLSE),RECFM=FBA,LRECL=133,BLKSIZE=0
//SYSOUT   DD SYSOUT=*
//CEEDUMP  DD SYSOUT=*
