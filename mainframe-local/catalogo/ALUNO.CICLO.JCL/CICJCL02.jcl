//CICJCL02 JOB ,'CICLO DO CARTAO',NOTIFY=&SYSUID,
//             CLASS=A,MSGCLASS=X
//*--------------------------------------------------------------------
//* AULA 2 - AUTORIZACAO SIMULADA EM BATCH (CICAUTOR)
//* GERA O LOG DE AUTORIZACOES E AS CONTAS COM OS LIMITES ATUALIZADOS.
//* PODE SER SUBMETIDO VARIAS VEZES: O STEP005 APAGA AS SAIDAS.
//*--------------------------------------------------------------------
//STEP005  EXEC PGM=IEFBR14
//LOGANT   DD DSN=&SYSUID..CICLO.AUTH.LOG,DISP=(MOD,DELETE),
//            SPACE=(TRK,(1,1)),RECFM=FB,LRECL=120
//CONANT   DD DSN=&SYSUID..CICLO.CONTAS.ATUAL,DISP=(MOD,DELETE),
//            SPACE=(TRK,(1,1)),RECFM=FB,LRECL=80
//*
//STEP010  EXEC PGM=CICAUTOR
//STEPLIB  DD DSN=&SYSUID..CICLO.LOAD,DISP=SHR
//CONTAS   DD DSN=&SYSUID..CICLO.CONTAS,DISP=SHR
//PEDIDOS  DD DSN=&SYSUID..CICLO.AUTH.PEDIDOS,DISP=SHR
//LOGOUT   DD DSN=&SYSUID..CICLO.AUTH.LOG,
//            DISP=(NEW,CATLG,DELETE),
//            SPACE=(TRK,(2,1),RLSE),RECFM=FB,LRECL=120,BLKSIZE=0
//CONTOUT  DD DSN=&SYSUID..CICLO.CONTAS.ATUAL,
//            DISP=(NEW,CATLG,DELETE),
//            SPACE=(TRK,(1,1),RLSE),RECFM=FB,LRECL=80,BLKSIZE=0
//SYSOUT   DD SYSOUT=*
//CEEDUMP  DD SYSOUT=*
