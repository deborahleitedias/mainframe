//FATJCL04 JOB ,'FATURA NOTURNA',NOTIFY=&SYSUID,
//             CLASS=A,MSGCLASS=X
//*--------------------------------------------------------------------
//* AULA 4 - CHECKPOINT 2: JOB SO DE UTILITARIOS
//*   STEP005 APAGA O BACKUP DO DIA ANTERIOR (SE EXISTIR)
//*   STEP010 COPIA AS TRANSACOES PARA BACKUP (IEBGENER)
//*   STEP020 ORDENA POR CARTAO, DATA E HORA E GRAVA NOVA GERACAO
//*           DO GDG. SO RODA SE O BACKUP TERMINOU COM RC 0.
//*--------------------------------------------------------------------
//STEP005  EXEC PGM=IEFBR14
//BKPANT   DD DSN=&SYSUID..FATURA.TRANS.BKP,DISP=(MOD,DELETE),
//            SPACE=(TRK,(1,1)),RECFM=FB,LRECL=80
//*
//STEP010  EXEC PGM=IEBGENER
//SYSPRINT DD SYSOUT=*
//SYSIN    DD DUMMY
//SYSUT1   DD DSN=&SYSUID..FATURA.TRANS.DIA,DISP=SHR
//SYSUT2   DD DSN=&SYSUID..FATURA.TRANS.BKP,DISP=(NEW,CATLG,DELETE),
//            SPACE=(TRK,(5,5),RLSE),RECFM=FB,LRECL=80,BLKSIZE=0
//*
// IF (STEP010.RC = 0) THEN
//STEP020  EXEC PGM=SORT
//SYSOUT   DD SYSOUT=*
//SORTIN   DD DSN=&SYSUID..FATURA.TRANS.DIA,DISP=SHR
//SORTOUT  DD DSN=&SYSUID..FATURA.TRANS.ORDEN(+1),
//            DISP=(NEW,CATLG,DELETE),
//            SPACE=(TRK,(5,5),RLSE),RECFM=FB,LRECL=80,BLKSIZE=0
//SYSIN    DD *
* CARTAO (1,16), DATA (17,8) E HORA (25,6), TODOS EM ORDEM CRESCENTE
  SORT FIELDS=(1,16,CH,A,17,8,CH,A,25,6,CH,A)
/*
// ENDIF
