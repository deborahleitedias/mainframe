//PEDNOITE JOB ,'PEDAGIO NOTURNO',NOTIFY=&SYSUID,
//             CLASS=A,MSGCLASS=X
//*====================================================================
//* PEDAGIO NOTURNO - EXTRATO DIARIO DAS PASSAGENS COM TAG
//* SISTEMA FICTICIO DA AVALIACAO PRATICA (DADOS 100% FICTICIOS)
//*   STEP005  APAGA AS SAIDAS DA EXECUCAO ANTERIOR (IEFBR14)
//*   STEP010  ORDENACAO POR TAG, DATA E HORA (SORT, GDG)
//*   STEP020  VALIDACAO DAS PASSAGENS (PEDVALID)
//*   STEP030  EXTRATO POR TAG (PEDEXTRT)
//*
//* REGRAS DE FLUXO:
//*   STEP020 SO RODA SE A ORDENACAO TERMINOU COM RC 0.
//*   STEP030 SO RODA SE A VALIDACAO TERMINOU COM RC <= 4
//*   (RC 4 = HOUVE REJEITADAS, O QUE E NORMAL).
//* OS PROGRAMAS FICAM NA MESMA BIBLIOTECA DO PROJETO (FATURA.LOAD).
//*====================================================================
//STEP005  EXEC PGM=IEFBR14
//APRANT   DD DSN=&SYSUID..PEDAGIO.PASSAGEM.APROV,DISP=(MOD,DELETE),
//            SPACE=(TRK,(1,1)),RECFM=FB,LRECL=80
//REJANT   DD DSN=&SYSUID..PEDAGIO.PASSAGEM.REJEI,DISP=(MOD,DELETE),
//            SPACE=(TRK,(1,1)),RECFM=FB,LRECL=120
//*
//STEP010  EXEC PGM=SORT
//SYSOUT   DD SYSOUT=*
//SORTIN   DD DSN=&SYSUID..PEDAGIO.PASSAGEM.DIA,DISP=SHR
//SORTOUT  DD DSN=&SYSUID..PEDAGIO.PASSAGEM.ORDEN(+1),
//            DISP=(NEW,CATLG,DELETE),
//            SPACE=(TRK,(1,1),RLSE),RECFM=FB,LRECL=80,BLKSIZE=0
//SYSIN    DD *
  SORT FIELDS=(1,12,CH,A,16,8,CH,A,24,6,CH,A)
/*
//*
// IF (STEP010.RC = 0) THEN
//STEP020  EXEC PGM=PEDVALID
//STEPLIB  DD DSN=&SYSUID..FATURA.LOAD,DISP=SHR
//PASSIN   DD DSN=&SYSUID..PEDAGIO.PASSAGEM.ORDEN(+1),DISP=SHR
//TARIFA   DD DSN=&SYSUID..PEDAGIO.TARIFA,DISP=SHR
//APROVOUT DD DSN=&SYSUID..PEDAGIO.PASSAGEM.APROV,
//            DISP=(NEW,CATLG,DELETE),
//            SPACE=(TRK,(1,1),RLSE),RECFM=FB,LRECL=80,BLKSIZE=0
//REJEIOUT DD DSN=&SYSUID..PEDAGIO.PASSAGEM.REJEI,
//            DISP=(NEW,CATLG,DELETE),
//            SPACE=(TRK,(1,1),RLSE),RECFM=FB,LRECL=120,BLKSIZE=0
//SYSOUT   DD SYSOUT=*
//CEEDUMP  DD SYSOUT=*
// ENDIF
//*
// IF (STEP020.RC <= 4) THEN
//STEP030  EXEC PGM=PEDEXTRT
//STEPLIB  DD DSN=&SYSUID..FATURA.LOAD,DISP=SHR
//APROVIN  DD DSN=&SYSUID..PEDAGIO.PASSAGEM.APROV,DISP=SHR
//EXTROUT  DD DSN=&SYSUID..PEDAGIO.EXTRATO(+1),
//            DISP=(NEW,CATLG,DELETE),
//            SPACE=(TRK,(1,1),RLSE),RECFM=FBA,LRECL=133,BLKSIZE=0
//SYSOUT   DD SYSOUT=*
//CEEDUMP  DD SYSOUT=*
// ENDIF
