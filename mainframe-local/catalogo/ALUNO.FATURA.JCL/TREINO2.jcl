//TREINO2  JOB ,'FATURA NOTURNA',NOTIFY=&SYSUID,
//             CLASS=A,MSGCLASS=X
//*--------------------------------------------------------------------
//* TREINO2: JOB DA FATURA NOTURNA DA MADRUGADA
//*   STEP005 LIMPA, STEP010 BACKUP, STEP020 SORT,
//*   STEP030 FILTRO (FATFILTR) E STEP040 RELATORIO (FATRELAT)
//*--------------------------------------------------------------------
//STEP005  EXEC PGM=IEFBR14
//BKPANT   DD DSN=&SYSUID..FATURA.TRANS.BKP,DISP=(MOD,DELETE),
//            SPACE=(TRK,(1,1)),RECFM=FB,LRECL=80
//APRANT   DD DSN=&SYSUID..FATURA.TRANS.APROV,DISP=(MOD,DELETE),
//            SPACE=(TRK,(1,1)),RECFM=FB,LRECL=80
//REJANT   DD DSN=&SYSUID..FATURA.TRANS.REJEI,DISP=(MOD,DELETE),
//            SPACE=(TRK,(1,1)),RECFM=FB,LRECL=120
//*
//STEP010  EXEC PGM=IEBGENER
//SYSPRINT DD SYSOUT=*
//SYSIN    DD DUMMY
//SYSUT1   DD DSN=&SYSUID..FATURA.TRANS.DIA,DISP=SHR
//SYSUT2   DD DSN=&SYSUID..FATURA.TRANS.BKP,DISP=(NEW,CATLG,DELETE),
//            SPACE=(TRK,(5,5),RLSE),RECFM=FB,LRECL=80,BLKSIZE=0
//*
// IF (STEP010.RC = 0) THEN
//STEP020  EXEC PGM=SORT
//SYSOUT   DD SYSOUT=*
//SORTIN   DD DSN=&SYSUID..FATURA.TRANS.DIA,DISP=SHR
//SORTOUT  DD DSN=&SYSUID..FATURA.TRANS.ORDEN(+1),
//            DISP=(NEW,CATLG,DELETE),
//            SPACE=(TRK,(5,5),RLSE),RECFM=FB,LRECL=80,BLKSIZE=0
//SYSIN    DD *
* CARTAO (1,16), DATA (17,8) E HORA (25,6), TODOS EM ORDEM CRESCENTE
  SORT FIELDS=(1,16,CH,A,17,8,CH,A,25,6,CH,A)
/*
// ENDIF
// IF (STEP020.RC = 0) THEN
//STEP030  EXEC PGM=FATFILTR
//STEPLIB  DD DSN=&SYSUID..FATURA.LOAD,DISP=SHR
//TRANSIN  DD DSN=&SYSUID..FATURA.TRANS.ORDEN(+1),DISP=SHR
//APROVOUT DD DSN=&SYSUID..FATURA.TRANS.APROV,
//            DISP=(NEW,CATLG,DELETE),
//            SPACE=(TRK,(2,2),RLSE),RECFM=FB,LRECL=80,BLKSIZE=0
//REJEIOUT DD DSN=&SYSUID..FATURA.TRANS.REJEI,
//            DISP=(NEW,CATLG,DELETE),
//            SPACE=(TRK,(1,1),RLSE),RECFM=FB,LRECL=120,BLKSIZE=0
//SYSOUT   DD SYSOUT=*
//CEEDUMP  DD SYSOUT=*
// ENDIF
