//STEPLIB  DD DSN=&SYSUID..FATURA.LOAD,DISP=SHR
//APROVIN  DD DSN=&SYSUID..FATURA.TRANS.APROV,DISP=SHR
//MCCTAB   DD DSN=&SYSUID..FATURA.COPY(MCCTABEL),DISP=SHR
//RELATOUT DD DSN=&SYSUID..FATURA.RELAT(+1),
//            DISP=(NEW,CATLG,DELETE),
//            SPACE=(TRK,(2,2),RLSE),RECFM=FBA,LRECL=133,BLKSIZE=0
//SYSOUT   DD SYSOUT=*
