//PRTPED   JOB ,'PEDAGIO NOTURNO',NOTIFY=&SYSUID,
//             CLASS=A,MSGCLASS=X
//*--------------------------------------------------------------------
//* PEDAGIO NOTURNO - MOSTRA O PEDAGIO.PASSAGEM.APROV EM HEXADECIMAL
//* (IDCAMS PRINT DUMP), REGISTRO A REGISTRO. O CAMPO PA-VALOR
//* (COMP-3) FICA NAS POSICOES 31 A 34 (DESLOCAMENTO X'1E' A X'21').
//* PARA VER SO ALGUNS REGISTROS, ACRESCENTE SKIP(N) E COUNT(N).
//*--------------------------------------------------------------------
//PRINT    EXEC PGM=IDCAMS
//SYSPRINT DD SYSOUT=*
//SYSIN    DD *,SYMBOLS=JCLONLY
  PRINT INDATASET(&SYSUID..PEDAGIO.PASSAGEM.APROV) DUMP
/*
