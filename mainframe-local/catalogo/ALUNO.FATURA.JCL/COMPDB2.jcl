//COMPDB2  JOB ,'FATURA NOTURNA',NOTIFY=&SYSUID,
//             CLASS=A,MSGCLASS=X
//*--------------------------------------------------------------------
//* AULA 11 - COMPILA PROGRAMA COBOL COM SQL (COPROCESSADOR DB2) E
//* FAZ O BIND DO PACKAGE E DO PLANO.
//*
//* ANTES DE USAR, CONFERIR NA PLATAFORMA E SUBSTITUIR:
//*   DB2LOAD  BIBLIOTECA SDSNLOAD DO DB2 (EX.: DSNXXX.SDSNLOAD)
//*   DBXX     NOME DO SUBSISTEMA DB2
//* A OPCAO SQL FAZ O COMPILADOR PROCESSAR OS EXEC SQL E GERAR O
//* DBRM NO DD DBRMLIB. O BIND TRANSFORMA O DBRM EM PACKAGE.
//*--------------------------------------------------------------------
//         SET PGM=FATDB2
//         SET DB2LOAD='DSNXXX.SDSNLOAD'
//*
//CL       EXEC IGYWCL,PARM.COBOL='SQL'
//COBOL.STEPLIB DD DSN=&DB2LOAD,DISP=SHR
//COBOL.SYSIN   DD DSN=&SYSUID..FATURA.COBOL(&PGM),DISP=SHR
//COBOL.SYSLIB  DD DSN=&SYSUID..FATURA.COPY,DISP=SHR
//COBOL.DBRMLIB DD DSN=&SYSUID..FATURA.DBRM(&PGM),DISP=SHR
//LKED.SYSLMOD  DD DSN=&SYSUID..FATURA.LOAD(&PGM),DISP=SHR
//*
// IF (CL.LKED.RC <= 4) THEN
//BIND     EXEC PGM=IKJEFT01,DYNAMNBR=20
//STEPLIB  DD DSN=&DB2LOAD,DISP=SHR
//DBRMLIB  DD DSN=&SYSUID..FATURA.DBRM,DISP=SHR
//SYSTSPRT DD SYSOUT=*
//SYSPRINT DD SYSOUT=*
//SYSTSIN  DD *
  DSN SYSTEM(DBXX)
  BIND PACKAGE(FATURA) MEMBER(FATDB2) ACTION(REPLACE) -
       ISOLATION(CS) VALIDATE(BIND)
  BIND PLAN(FATDB2P) PKLIST(FATURA.*) ACTION(REPLACE)
  END
/*
// ENDIF
//*--------------------------------------------------------------------
//* A BIBLIOTECA FATURA.DBRM E CRIADA PELO JOB ALOCAR (AULA 3).
//*--------------------------------------------------------------------
