//RUNSQL   JOB ,'FATURA NOTURNA',NOTIFY=&SYSUID,
//             CLASS=A,MSGCLASS=X
//*--------------------------------------------------------------------
//* AULA 10 - EXECUTA COMANDOS SQL EM BATCH COM O PROGRAMA DSNTEP2
//* (ALTERNATIVA AO SPUFI). O SQL FICA NO MEMBRO INDICADO EM SYSIN.
//* SUBSTITUIR DBXX, DSNXXX E O NOME DO PLANO DO DSNTEP2 CONFORME A
//* PLATAFORMA (COSTUMA SER DSNTEPnn, ONDE nn E A VERSAO DO DB2).
//*--------------------------------------------------------------------
//RUNSQL   EXEC PGM=IKJEFT01,DYNAMNBR=20
//STEPLIB  DD DSN=DSNXXX.SDSNLOAD,DISP=SHR
//SYSTSPRT DD SYSOUT=*
//SYSPRINT DD SYSOUT=*
//SYSUDUMP DD SYSOUT=*
//SYSTSIN  DD *
  DSN SYSTEM(DBXX)
  RUN PROGRAM(DSNTEP2) PLAN(DSNTEPXX) -
      LIB('DSNXXX.RUNLIB.LOAD')
  END
/*
//SYSIN    DD DSN=&SYSUID..FATURA.JCL(SQLDDL),DISP=SHR
