//FATNOITE JOB ,'FATURA NOTURNA',NOTIFY=&SYSUID,
//             CLASS=A,MSGCLASS=X
//*====================================================================
//* FATURA NOTURNA - JOB COMPLETO (RESULTADO FINAL DO MODULO)
//*   STEP005  APAGA BACKUP ANTERIOR ................... AULA 4
//*   STEP010  BACKUP DAS TRANSACOES (IEBGENER) ........ AULA 4
//*   STEP020  ORDENACAO E NOVA GERACAO (SORT, GDG) .... AULA 4
//*   STEP030  VALIDACAO E FILTRO (FATFILTR) ........... AULAS 7 E 9
//*   STEP040  RELATORIO DE FATURAS (FATRELAT) ......... AULA 8
//*   STEP050  FECHAMENTO NO DB2 (FATDB2) .............. AULA 11
//*   STEP060  CONCILIACAO DE PAGAMENTOS (FATCONCI) .... AULA 9
//*
//* REGRAS DE FLUXO:
//*   STEP030 SO RODA SE A ORDENACAO TERMINOU COM RC 0.
//*   STEP040 E STEP050 SO RODAM SE O FILTRO TERMINOU COM RC <= 4
//*   (RC 4 = HOUVE REJEITADAS, O QUE E NORMAL).
//*   STEP060 NAO DEPENDE DO RC DO FILTRO, MAS, COMO TODO STEP, E
//*   PULADO SE UM STEP ANTERIOR ABENDAR.
//*====================================================================
//STEP005  EXEC PGM=IEFBR14
//BKPANT   DD DSN=&SYSUID..FATURA.TRANS.BKP,DISP=(MOD,DELETE),
//            SPACE=(TRK,(1,1)),RECFM=FB,LRECL=80
//APRANT   DD DSN=&SYSUID..FATURA.TRANS.APROV,DISP=(MOD,DELETE),
//            SPACE=(TRK,(1,1)),RECFM=FB,LRECL=80
//REJANT   DD DSN=&SYSUID..FATURA.TRANS.REJEI,DISP=(MOD,DELETE),
//            SPACE=(TRK,(1,1)),RECFM=FB,LRECL=120
//DIVANT   DD DSN=&SYSUID..FATURA.DIVERG,DISP=(MOD,DELETE),
//            SPACE=(TRK,(1,1)),RECFM=FB,LRECL=80
//*
//STEP010  EXEC PGM=IEBGENER
//SYSPRINT DD SYSOUT=*
//SYSIN    DD DUMMY
//SYSUT1   DD DSN=&SYSUID..FATURA.TRANS.DIA,DISP=SHR
//SYSUT2   DD DSN=&SYSUID..FATURA.TRANS.BKP,DISP=(NEW,CATLG,DELETE),
//            SPACE=(TRK,(5,5),RLSE),RECFM=FB,LRECL=80,BLKSIZE=0
//*
// IF (STEP010.RC = 0) THEN
//STEP020  EXEC PGM=SORT
//SYSOUT   DD SYSOUT=*
//SORTIN   DD DSN=&SYSUID..FATURA.TRANS.DIA,DISP=SHR
//SORTOUT  DD DSN=&SYSUID..FATURA.TRANS.ORDEN(+1),
//            DISP=(NEW,CATLG,DELETE),
//            SPACE=(TRK,(5,5),RLSE),RECFM=FB,LRECL=80,BLKSIZE=0
//SYSIN    DD *
  SORT FIELDS=(1,16,CH,A,17,8,CH,A,25,6,CH,A)
/*
// ENDIF
//*
// IF (STEP020.RC = 0) THEN
//STEP030  EXEC PGM=FATFILTR
//STEPLIB  DD DSN=&SYSUID..FATURA.LOAD,DISP=SHR
//TRANSIN  DD DSN=&SYSUID..FATURA.TRANS.ORDEN(+1),DISP=SHR
//APROVOUT DD DSN=&SYSUID..FATURA.TRANS.APROV,
//            DISP=(NEW,CATLG,DELETE),
//            SPACE=(TRK,(5,5),RLSE),RECFM=FB,LRECL=80,BLKSIZE=0
//REJEIOUT DD DSN=&SYSUID..FATURA.TRANS.REJEI,
//            DISP=(NEW,CATLG,DELETE),
//            SPACE=(TRK,(1,1),RLSE),RECFM=FB,LRECL=120,BLKSIZE=0
//SYSOUT   DD SYSOUT=*
//CEEDUMP  DD SYSOUT=*
// ENDIF
//*
// IF (STEP030.RC <= 4) THEN
//STEP040  EXEC PGM=FATRELAT
//STEPLIB  DD DSN=&SYSUID..FATURA.LOAD,DISP=SHR
//APROVIN  DD DSN=&SYSUID..FATURA.TRANS.APROV,DISP=SHR
//MCCTAB   DD DSN=&SYSUID..FATURA.MCC.TABELA,DISP=SHR
//RELATOUT DD DSN=&SYSUID..FATURA.RELAT(+1),
//            DISP=(NEW,CATLG,DELETE),
//            SPACE=(TRK,(5,5),RLSE),RECFM=FBA,LRECL=133,BLKSIZE=0
//SYSOUT   DD SYSOUT=*
//CEEDUMP  DD SYSOUT=*
//*
//*------------------------------------------------------------------
//* STEP050 (AULA 11): SUBSTITUIR DBXX PELO SUBSISTEMA DB2 E SEUID
//* PELO SEU ID DE USUARIO. CONFERIR O NOME DO PLANO DO BIND.
//*------------------------------------------------------------------
//STEP050  EXEC PGM=IKJEFT01,DYNAMNBR=20
//STEPLIB  DD DSN=&SYSUID..FATURA.LOAD,DISP=SHR
//APROVIN  DD DSN=&SYSUID..FATURA.TRANS.APROV,DISP=SHR
//SYSTSPRT DD SYSOUT=*
//SYSOUT   DD SYSOUT=*
//CEEDUMP  DD SYSOUT=*
//SYSTSIN  DD *
  DSN SYSTEM(DBXX)
  RUN PROGRAM(FATDB2) PLAN(FATDB2P) LIB('SEUID.FATURA.LOAD')
  END
/*
// ENDIF
//*
//STEP060  EXEC PGM=FATCONCI
//STEPLIB  DD DSN=&SYSUID..FATURA.LOAD,DISP=SHR
//FATIN    DD DSN=&SYSUID..FATURA.FATURAS.ABERTO,DISP=SHR
//PAGIN    DD DSN=&SYSUID..FATURA.PAGTOS.DIA,DISP=SHR
//DIVEROUT DD DSN=&SYSUID..FATURA.DIVERG,
//            DISP=(NEW,CATLG,DELETE),
//            SPACE=(TRK,(1,1),RLSE),RECFM=FB,LRECL=80,BLKSIZE=0
//SYSOUT   DD SYSOUT=*
//CEEDUMP  DD SYSOUT=*
