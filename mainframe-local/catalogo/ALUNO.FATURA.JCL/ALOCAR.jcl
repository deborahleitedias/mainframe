//ALOCAR   JOB ,'FATURA NOTURNA',NOTIFY=&SYSUID,
//             CLASS=A,MSGCLASS=X
//*--------------------------------------------------------------------
//* AULA 3 - ALOCACAO DAS BIBLIOTECAS E ARQUIVOS DO PROJETO-GUIA
//* EXECUTAR UMA UNICA VEZ. SE PRECISAR REFAZER, APAGAR ANTES OS
//* DATASETS (OU TROCAR DISP=(NEW,CATLG) POR (MOD,CATLG) NOS PS).
//*--------------------------------------------------------------------
//STEP010  EXEC PGM=IEFBR14
//COBOL    DD DSN=&SYSUID..FATURA.COBOL,DISP=(NEW,CATLG),
//            SPACE=(TRK,(10,5,20)),DSNTYPE=PDS,
//            RECFM=FB,LRECL=80,BLKSIZE=0
//JCL      DD DSN=&SYSUID..FATURA.JCL,DISP=(NEW,CATLG),
//            SPACE=(TRK,(10,5,20)),DSNTYPE=PDS,
//            RECFM=FB,LRECL=80,BLKSIZE=0
//COPY     DD DSN=&SYSUID..FATURA.COPY,DISP=(NEW,CATLG),
//            SPACE=(TRK,(5,5,20)),DSNTYPE=PDS,
//            RECFM=FB,LRECL=80,BLKSIZE=0
//DBRM     DD DSN=&SYSUID..FATURA.DBRM,DISP=(NEW,CATLG),
//            SPACE=(TRK,(5,5,20)),DSNTYPE=PDS,
//            RECFM=FB,LRECL=80,BLKSIZE=0
//LOAD     DD DSN=&SYSUID..FATURA.LOAD,DISP=(NEW,CATLG),
//            SPACE=(TRK,(15,5)),DSNTYPE=LIBRARY,
//            RECFM=U,LRECL=0,BLKSIZE=32760
//TRANS    DD DSN=&SYSUID..FATURA.TRANS.DIA,DISP=(NEW,CATLG),
//            SPACE=(TRK,(5,5)),RECFM=FB,LRECL=80,BLKSIZE=0
//MCC      DD DSN=&SYSUID..FATURA.MCC.TABELA,DISP=(NEW,CATLG),
//            SPACE=(TRK,(1,1)),RECFM=FB,LRECL=80,BLKSIZE=0
//PAGTOS   DD DSN=&SYSUID..FATURA.PAGTOS.DIA,DISP=(NEW,CATLG),
//            SPACE=(TRK,(1,1)),RECFM=FB,LRECL=80,BLKSIZE=0
//FATURAS  DD DSN=&SYSUID..FATURA.FATURAS.ABERTO,DISP=(NEW,CATLG),
//            SPACE=(TRK,(1,1)),RECFM=FB,LRECL=80,BLKSIZE=0
