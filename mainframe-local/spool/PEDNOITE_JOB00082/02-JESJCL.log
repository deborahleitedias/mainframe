        1 //PEDNOITE JOB ,'PEDAGIO NOTURNO',NOTIFY=&SYSUID,
          //             CLASS=A,MSGCLASS=X
          //*====================================================================
          //* PEDAGIO NOTURNO - EXTRATO DIARIO DAS PASSAGENS COM TAG
          //* SISTEMA FICTICIO DA AVALIACAO PRATICA (DADOS 100% FICTICIOS)
          //*   STEP005  APAGA AS SAIDAS DA EXECUCAO ANTERIOR (IEFBR14)
          //*   STEP010  ORDENACAO POR TAG, DATA E HORA (SORT, GDG)
          //*   STEP020  VALIDACAO DAS PASSAGENS (PEDVALID)
          //*   STEP030  EXTRATO POR TAG (PEDEXTRT)
          //*
          //* REGRAS DE FLUXO:
          //*   STEP020 SO RODA SE A ORDENACAO TERMINOU COM RC 0.
          //*   STEP030 SO RODA SE A VALIDACAO TERMINOU COM RC <= 4
          //*   (RC 4 = HOUVE REJEITADAS, O QUE E NORMAL).
          //* OS PROGRAMAS FICAM NA MESMA BIBLIOTECA DO PROJETO (FATURA.LOAD).
          //*====================================================================
        2 //STEP005  EXEC PGM=IEFBR14
        3 //APRANT   DD DSN=&SYSUID..PEDAGIO.PASSAGEM.APROV,DISP=(MOD,DELETE),
          //            SPACE=(TRK,(1,1)),RECFM=FB,LRECL=80
        4 //REJANT   DD DSN=&SYSUID..PEDAGIO.PASSAGEM.REJEI,DISP=(MOD,DELETE),
          //            SPACE=(TRK,(1,1)),RECFM=FB,LRECL=120
          //*
        5 //STEP010  EXEC PGM=SORT
        6 //SYSOUT   DD SYSOUT=*
        7 //SORTIN   DD DSN=&SYSUID..PEDAGIO.PASSAGEM.DIA,DISP=SHR
        8 //SORTOUT  DD DSN=&SYSUID..PEDAGIO.PASSAGEM.ORDEN(+1),
          //            DISP=(NEW,CATLG,DELETE),
          //            SPACE=(TRK,(1,1),RLSE),RECFM=FB,LRECL=80,BLKSIZE=0
        9 //SYSIN    DD *
          /*
          //*
       10 // IF (STEP010.RC = 0) THEN
       11 //STEP020  EXEC PGM=PEDVALID
       12 //STEPLIB  DD DSN=&SYSUID..FATURA.LOAD,DISP=SHR
       13 //PASSIN   DD DSN=&SYSUID..PEDAGIO.PASSAGEM.ORDEN(+1),DISP=SHR
       14 //TARIFA   DD DSN=&SYSUID..PEDAGIO.TARIFA,DISP=SHR
       15 //APROVOUT DD DSN=&SYSUID..PEDAGIO.PASSAGEM.APROV,
          //            DISP=(NEW,CATLG,DELETE),
          //            SPACE=(TRK,(1,1),RLSE),RECFM=FB,LRECL=80,BLKSIZE=0
       16 //REJEIOUT DD DSN=&SYSUID..PEDAGIO.PASSAGEM.REJEI,
          //            DISP=(NEW,CATLG,DELETE),
          //            SPACE=(TRK,(1,1),RLSE),RECFM=FB,LRECL=120,BLKSIZE=0
       17 //SYSOUT   DD SYSOUT=*
       18 //CEEDUMP  DD SYSOUT=*
       19 // ENDIF
          //*
       20 // IF (STEP020.RC <= 4) THEN
       21 //STEP030  EXEC PGM=PEDEXTRT
       22 //STEPLIB  DD DSN=&SYSUID..FATURA.LOAD,DISP=SHR
       23 //APROVIN  DD DSN=&SYSUID..PEDAGIO.PASSAGEM.APROV,DISP=SHR
       24 //EXTROUT  DD DSN=&SYSUID..PEDAGIO.EXTRATO(+1),
          //            DISP=(NEW,CATLG,DELETE),
          //            SPACE=(TRK,(1,1),RLSE),RECFM=FBA,LRECL=133,BLKSIZE=0
       25 //SYSOUT   DD SYSOUT=*
       26 //CEEDUMP  DD SYSOUT=*
       27 // ENDIF
