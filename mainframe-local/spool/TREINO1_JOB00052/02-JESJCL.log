        1 //TREINO1  JOB ,'FATURA NOTURNA',NOTIFY=&SYSUID,
          //             CLASS=A,MSGCLASS=X
          //*--------------------------------------------------------------------
          //* TREINO1: JOB DA FATURA NOTURNA DA MADRUGADA
          //*   STEP005 LIMPA, STEP010 BACKUP, STEP020 SORT,
          //*   STEP030 FILTRO (FATFILTR) E STEP040 RELATORIO (FATRELAT)
          //*--------------------------------------------------------------------
        2 //STEP005  EXEC PGM=IEFBR14
        3 //BKPANT   DD DSN=&SYSUID..FATURA.TRANS.BKP,DISP=(MOD,DELETE),
          //            SPACE=(TRK,(1,1)),RECFM=FB,LRECL=80
        4 //APRANT   DD DSN=&SYSUID..FATURA.TRANS.APROV,DISP=(MOD,DELETE),
          //            SPACE=(TRK,(1,1)),RECFM=FB,LRECL=80
        5 //REJANT   DD DSN=&SYSUID..FATURA.TRANS.REJEI,DISP=(MOD,DELETE),
          //            SPACE=(TRK,(1,1)),RECFM=FB,LRECL=120
          //*
        6 //STEP010  EXEC PGM=IEBGENER
        7 //SYSPRINT DD SYSOUT=*
        8 //SYSIN    DD DUMMY
        9 //SYSUT1   DD DSN=&SYSUID..FATURA.TRANS.DIA,DISP=SHR
       10 //SYSUT2   DD DSN=&SYSUID..FATURA.TRANS.BKP,DISP=(NEW,CATLG,DELETE),
          //            SPACE=(TRK,(5,5),RLSE),RECFM=FB,LRECL=80,BLKSIZE=0
          //*
       11 // IF (STEP010.RC = 0) THEN
       12 //STEP020  EXEC PGM=SORT
       13 //SYSOUT   DD SYSOUT=*
       14 //SORTIN   DD DSN=&SYSUID..FATURA.TRANS.DIA,DISP=SHR
       15 //SORTOUT  DD DSN=&SYSUID..FATURA.TRANS.ORDEN(+1),
          //            DISP=(NEW,CATLG,DELETE),
          //            SPACE=(TRK,(5,5),RLSE),RECFM=FB,LRECL=80,BLKSIZE=0
       16 //SYSIN    DD *
          /*
       17 // ENDIF
       18 // IF (STEP020.RC = 0) THEN
       19 //STEP030  EXEC PGM=FATFILT
       20 //STEPLIB  DD DSN=&SYSUID..FATURA.LOAD,DISP=SHR
       21 //TRANSIN  DD DSN=&SYSUID..FATURA.TRANS.ORDEN(+1),DISP=SHR
       22 //APROVOUT DD DSN=&SYSUID..FATURA.TRANS.APROV,
          //            DISP=(NEW,CATLG,DELETE),
          //            SPACE=(TRK,(2,2),RLSE),RECFM=FB,LRECL=80,BLKSIZE=0
       23 //REJEIOUT DD DSN=&SYSUID..FATURA.TRANS.REJEI,
          //            DISP=(NEW,CATLG,DELETE),
          //            SPACE=(TRK,(1,1),RLSE),RECFM=FB,LRECL=120,BLKSIZE=0
       24 //SYSOUT   DD SYSOUT=*
       25 //CEEDUMP  DD SYSOUT=*
       26 // ENDIF
       27 // IF (STEP030.RC <= 4) THEN
       28 //STEP040  EXEC PGM=FATRELAT
       29 //STEPLIB  DD DSN=&SYSUID..FATURA.LOAD,DISP=SHR
       30 //APROVIN  DD DSN=&SYSUID..FATURA.TRANS.APROV,DISP=SHR
       31 //MCCTAB   DD DSN=&SYSUID..FATURA.MCC.TABELA,DISP=SHR
       32 //RELATOUT DD DSN=&SYSUID..FATURA.RELAT(+1),
          //            DISP=(NEW,CATLG,DELETE),
          //            SPACE=(TRK,(2,2),RLSE),RECFM=FBA,LRECL=133,BLKSIZE=0
       33 //SYSOUT   DD SYSOUT=*
       34 //CEEDUMP  DD SYSOUT=*
       35 // ENDIF
