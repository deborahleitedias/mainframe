        1 //ALOCPED  JOB ,'PEDAGIO NOTURNO',NOTIFY=&SYSUID,
          //             CLASS=A,MSGCLASS=X
          //*--------------------------------------------------------------------
          //* PEDAGIO NOTURNO - ALOCACAO DOS ARQUIVOS DE DADOS E DAS BASES GDG
          //* EXECUTAR UMA UNICA VEZ. OS FONTES, JOBS E PROGRAMAS USAM AS
          //* BIBLIOTECAS DO PROJETO (FATURA.COBOL, FATURA.JCL, FATURA.LOAD);
          //* SO OS DADOS GANHAM O PREFIXO PEDAGIO.
          //* SE PRECISAR REFAZER, APAGAR ANTES OS DATASETS PEDAGIO.* E AS
          //* BASES GDG (DELETE ... GDG FORCE NO IDCAMS).
          //*--------------------------------------------------------------------
        2 //STEP010  EXEC PGM=IEFBR14
        3 //PASSAG   DD DSN=&SYSUID..PEDAGIO.PASSAGEM.DIA,DISP=(NEW,CATLG),
          //            SPACE=(TRK,(1,1)),RECFM=FB,LRECL=80,BLKSIZE=0
        4 //TARIFA   DD DSN=&SYSUID..PEDAGIO.TARIFA,DISP=(NEW,CATLG),
          //            SPACE=(TRK,(1,1)),RECFM=FB,LRECL=80,BLKSIZE=0
          //*
        5 //STEP020  EXEC PGM=IDCAMS
        6 //SYSPRINT DD SYSOUT=*
        7 //SYSIN    DD *,SYMBOLS=JCLONLY
          /*
