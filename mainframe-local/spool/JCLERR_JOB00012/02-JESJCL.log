        1       *================================================================*
        2       * PROGRAMA : FATJUROS                                            *
        3       * AULA     : 5 - COBOL I, ANATOMIA DE UM PROGRAMA                *
        4       * OBJETIVO : CALCULAR O TOTAL DA FATURA DE UM CLIENTE, COM MULTA *
        5       *            E JUROS SOBRE O SALDO ANTERIOR EM ATRASO.           *
        6       *            TRADUCAO DIRETA DO PSEUDOCODIGO DA AULA 1.          *
        7       * REGRAS   : MULTA DE 2% SOBRE O SALDO EM ATRASO.                *
        8       *            JUROS DE 1% AO MES, PROPORCIONAIS AOS DIAS DE       *
        9       *            ATRASO (1% / 30 POR DIA).                           *
       10       * PROJETO  : FATURA NOTURNA - DADOS FICTICIOS                    *
       11       *================================================================*
       12        IDENTIFICATION DIVISION.
       13        PROGRAM-ID. FATJUROS.
       14 
       15        ENVIRONMENT DIVISION.
       16 
       17        DATA DIVISION.
       18        WORKING-STORAGE SECTION.
       19       *--- ENTRADAS (VALORES FIXOS NESTA AULA; ARQUIVOS NA AULA 7) ----*
       20        01  WS-COMPRAS.
       21            05  WS-COMPRA-1            PIC 9(07)V99 VALUE 13.13.
       22            05  WS-COMPRA-2            PIC 9(07)V99 VALUE 80.90.
       23            05  WS-COMPRA-3            PIC 9(07)V99 VALUE 1500.00.
       24            05  WS-COMPRA-4            PIC 9(07)V99 VALUE 245.50.
       25            05  WS-COMPRA-5            PIC 9(07)V99 VALUE 310.00.
       26        01  WS-SALDO-ANTERIOR          PIC 9(07)V99 VALUE 800.00.
       27        01  WS-DIAS-ATRASO             PIC 9(03)    VALUE 13.
       28        01  WS-LIMITE                  PIC 9(07)V99 VALUE 1000.00.
       29 
       30       *--- CONSTANTES DE NEGOCIO --------------------------------------*
       31        01  WS-TAXA-MULTA              PIC V9(04)   VALUE .0200.
       32        01  WS-TAXA-JUROS-MES          PIC V9(04)   VALUE .0100.
       33 
       34       *--- AREAS DE CALCULO -------------------------------------------*
       35        01  WS-TOTAL-COMPRAS           PIC 9(09)V99 VALUE ZERO.
       36        01  WS-MULTA                   PIC 9(07)V99 VALUE ZERO.
       37        01  WS-JUROS                   PIC 9(07)V99 VALUE ZERO.
       38        01  WS-TOTAL-FATURA            PIC 9(09)V99 VALUE ZERO.
       39        01  WS-QTD-ACIMA-LIMITE        PIC 9(02)    VALUE ZERO.
       40 
       41       *--- CAMPOS EDITADOS PARA EXIBICAO ------------------------------*
       42        01  WS-VALOR-EDITADO           PIC ZZZ,ZZZ,ZZ9.99.
       43 
       44        PROCEDURE DIVISION.
       45        0000-PRINCIPAL.
       46            ADD WS-COMPRA-1 WS-COMPRA-2 WS-COMPRA-3
       47                WS-COMPRA-4 WS-COMPRA-5
       48                GIVING WS-TOTAL-COMPRAS
       49 
       50            IF WS-COMPRA-1 > WS-LIMITE
       51               ADD 1 TO WS-QTD-ACIMA-LIMITE
       52            END-IF
       53            IF WS-COMPRA-2 > WS-LIMITE
       54               ADD 1 TO WS-QTD-ACIMA-LIMITE
       55            END-IF
       56            IF WS-COMPRA-3 > WS-LIMITE
       57               ADD 1 TO WS-QTD-ACIMA-LIMITE
       58            END-IF
       59            IF WS-COMPRA-4 > WS-LIMITE
       60               ADD 1 TO WS-QTD-ACIMA-LIMITE
       61            END-IF
       62            IF WS-COMPRA-5 > WS-LIMITE
       63               ADD 1 TO WS-QTD-ACIMA-LIMITE
       64            END-IF
       65 
       66            IF WS-DIAS-ATRASO > ZERO
       67               COMPUTE WS-MULTA ROUNDED =
       68                       WS-SALDO-ANTERIOR * WS-TAXA-MULTA
       69               COMPUTE WS-JUROS ROUNDED =
       70                       WS-SALDO-ANTERIOR * WS-TAXA-JUROS-MES
       71                       * WS-DIAS-ATRASO / 30
       72               END-COMPUTE
       73            END-IF
       74 
       75            COMPUTE WS-TOTAL-FATURA =
       76                    WS-TOTAL-COMPRAS + WS-SALDO-ANTERIOR
       77                    + WS-MULTA + WS-JUROS
       78               ON SIZE ERROR
       79                  DISPLAY 'FATJUROS - ESTOURO NO TOTAL DA FATURA'
       80                  MOVE 16 TO RETURN-CODE
       81                  GOBACK
       82            END-COMPUTE
       83 
       84            DISPLAY '=== FATURA DO CLIENTE (DADOS FICTICIOS) ==='
       85            MOVE WS-TOTAL-COMPRAS  TO WS-VALOR-EDITADO
       86            DISPLAY 'TOTAL DE COMPRAS ......: ' WS-VALOR-EDITADO
       87            MOVE WS-SALDO-ANTERIOR TO WS-VALOR-EDITADO
       88            DISPLAY 'SALDO ANTERIOR ........: ' WS-VALOR-EDITADO
       89            MOVE WS-MULTA          TO WS-VALOR-EDITADO
       90            DISPLAY 'MULTA (2%) ............: ' WS-VALOR-EDITADO
       91            MOVE WS-JUROS          TO WS-VALOR-EDITADO
       92            DISPLAY 'JUROS PRO RATA ........: ' WS-VALOR-EDITADO
       93            MOVE WS-TOTAL-FATURA   TO WS-VALOR-EDITADO
       94            DISPLAY 'TOTAL DA FATURA .......: ' WS-VALOR-EDITADO
       95            DISPLAY 'COMPRAS ACIMA DO LIMITE: ' WS-QTD-ACIMA-LIMITE
       96 
       97            GOBACK.
