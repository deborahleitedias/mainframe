        1 
        2       *================================================================*
        3       * PROGRAMA : FATCLASS (ESQUELETO PARA A TURMA)                   *
        4       * AULA     : 6 - COBOL II, DECISAO E REPETICAO                   *
        5       * OBJETIVO : CLASSIFICAR TRANSACOES EM APROVADA, NEGADA OU       *
        6       *            SUSPEITA E VALIDAR O NUMERO DO CARTAO (LUHN).       *
        7       * O QUE VOCE ESCREVE:                                            *
        8       *   1. OS NIVEIS 88 MARCADOS NA TABELA DE TESTE;                 *
        9       *   2. O EVALUATE TRUE DO PARAGRAFO 2100-CLASSIFICAR-TRANSACAO.  *
       10       * O PARAGRAFO 9100-VALIDAR-LUHN JA ESTA PRONTO: LEIA E COMPARE   *
       11       * COM O PSEUDOCODIGO DE LUHN DA AULA 2.                          *
       12       * REGRAS   : CARTAO INVALIDO = NUMERO REPROVADO NO LUHN          *
       13       *            NEGADA   = STATUS 'N' DA AUTORIZACAO                *
       14       *            SUSPEITA = APROVADA, FORA DO PAIS E VALOR ACIMA     *
       15       *                       DE 5.000,00                              *
       16       *            APROVADA = DEMAIS CASOS                             *
       17       *================================================================*
       18        IDENTIFICATION DIVISION.
       19        PROGRAM-ID. FATCLASS.
       20 
       21        DATA DIVISION.
       22        WORKING-STORAGE SECTION.
       23        01  WS-LIMITE-SUSPEITA         PIC 9(09)V99 VALUE 5000.00.
       24 
       25       *--- MASSA DE TESTE ---------------------------------------------*
       26        01  WS-MASSA-TESTE.
       27            05  FILLER PIC X(31) VALUE
       28                '990000073702838300000015000BRAA'.
       29            05  FILLER PIC X(31) VALUE
       30                '990000073702838300000750000USAA'.
       31            05  FILLER PIC X(31) VALUE
       32                '990000079819331600000020000BRAN'.
       33            05  FILLER PIC X(31) VALUE
       34                '990000079819331700000020000BRAA'.
       35            05  FILLER PIC X(31) VALUE
       36                '990000079819331600000450000ARGA'.
       37            05  FILLER PIC X(31) VALUE
       38                '990000073702838300000500000USAA'.
       39 
       40        01  WS-TABELA-TESTE REDEFINES WS-MASSA-TESTE.
       41            05  WS-TRANS-TESTE OCCURS 6 TIMES.
       42                10  WS-T-CARTAO        PIC X(16).
       43                10  WS-T-VALOR         PIC 9(09)V99.
       44                10  WS-T-PAIS          PIC X(03).
       45                    88  WS-T-NACIONAL VALUE 'BRA'.
       46                10  WS-T-STATUS        PIC X(01).
       47                    88  WS-T-APROVADA VALUE 'A'.
       48                    88  WS-T-NEGADA   VALUE 'N'.
       49 
       50        01  WS-IND                     PIC 9(02).
       51        01  WS-CLASSIFICACAO           PIC X(20).
       52 
       53       *--- AREAS DO ALGORITMO DE LUHN ---------------------------------*
       54        01  WS-LUHN-CARTAO             PIC X(16).
       55        01  WS-LUHN-DIGITOS REDEFINES WS-LUHN-CARTAO.
       56            05  WS-LUHN-DIGITO         PIC 9(01) OCCURS 16 TIMES.
       57        01  WS-LUHN-POS                PIC 9(02).
       58        01  WS-LUHN-PARCELA            PIC 9(02).
       59        01  WS-LUHN-SOMA               PIC 9(03).
       60        01  WS-LUHN-DOBRAR             PIC X(01).
       61            88  WS-LUHN-DOBRA          VALUE 'S'.
       62            88  WS-LUHN-NAO-DOBRA      VALUE 'N'.
       63        01  WS-LUHN-RESULTADO          PIC X(01).
       64            88  WS-LUHN-VALIDO         VALUE 'S'.
       65            88  WS-LUHN-INVALIDO       VALUE 'N'.
       66 
       67        PROCEDURE DIVISION.
       68        0000-PRINCIPAL.
       69            PERFORM 2100-CLASSIFICAR-TRANSACAO
       70               VARYING WS-IND FROM 1 BY 1
       71               UNTIL WS-IND > 6
       72            GOBACK.
       73 
       74        2100-CLASSIFICAR-TRANSACAO.
       75            MOVE SPACES TO WS-CLASSIFICACAO
       76            MOVE WS-T-CARTAO(WS-IND) TO WS-LUHN-CARTAO
       77            PERFORM 9100-VALIDAR-LUHN
       78 
       79            EVALUATE TRUE
       80                WHEN WS-LUHN-INVALIDO
       81                    MOVE 'CARTAO INVALIDO'
       82                      TO WS-CLASSIFICACAO
       83 
       84                WHEN WS-T-NEGADA(WS-IND)
       85                    MOVE 'NEGADA'
       86                      TO WS-CLASSIFICACAO
       87 
       88                WHEN WS-T-APROVADA(WS-IND)
       89                 AND NOT WS-T-NACIONAL(WS-IND)
       90                 AND WS-T-VALOR(WS-IND) > WS-LIMITE-SUSPEITA
       91                    MOVE 'SUSPEITA'
       92                      TO WS-CLASSIFICACAO
       93 
       94                WHEN OTHER
       95                    MOVE 'APROVADA'
       96                      TO WS-CLASSIFICACAO
       97            END-EVALUATE
       98 
       99            DISPLAY 'TRANSACAO ' WS-IND ': ' WS-CLASSIFICACAO
      100            .
      101 
      102       *----------------------------------------------------------------*
      103       * ALGORITMO DE LUHN
      104       *----------------------------------------------------------------*
      105        9100-VALIDAR-LUHN.
      106            SET WS-LUHN-INVALIDO TO TRUE
      107            IF WS-LUHN-CARTAO IS NUMERIC
      108               MOVE ZERO TO WS-LUHN-SOMA
      109               SET WS-LUHN-NAO-DOBRA TO TRUE
      110               PERFORM VARYING WS-LUHN-POS FROM 16 BY -1
      111                       UNTIL WS-LUHN-POS < 1
      112                  MOVE WS-LUHN-DIGITO(WS-LUHN-POS)
      113                    TO WS-LUHN-PARCELA
      114                  IF WS-LUHN-DOBRA
      115                     COMPUTE WS-LUHN-PARCELA =
      116                        WS-LUHN-PARCELA * 2
      117                     IF WS-LUHN-PARCELA > 9
      118                        SUBTRACT 9 FROM WS-LUHN-PARCELA
      119                     END-IF
      120                     SET WS-LUHN-NAO-DOBRA TO TRUE
      121                  ELSE
      122                     SET WS-LUHN-DOBRA TO TRUE
      123                  END-IF
      124                  ADD WS-LUHN-PARCELA TO WS-LUHN-SOMA
      125               END-PERFORM
      126               IF FUNCTION MOD(WS-LUHN-SOMA, 10) = ZERO
      127                  SET WS-LUHN-VALIDO TO TRUE
      128               END-IF
      129            END-IF
      130            .
