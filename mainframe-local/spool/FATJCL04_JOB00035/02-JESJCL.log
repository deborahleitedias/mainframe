        1 //FATJCL04 JOB ,'FATURA NOTURNA',NOTIFY=&SYSUID,
          //             CLASS=A,MSGCLASS=X
          //*--------------------------------------------------------------------
          //* AULA 4 - CHECKPOINT 2: JOB SO DE UTILITARIOS
          //*   STEP005 APAGA O BACKUP DO DIA ANTERIOR (SE EXISTIR)
          //*   STEP010 COPIA AS TRANSACOES PARA BACKUP (IEBGENER)
          //*   STEP020 ORDENA POR CARTAO, DATA E HORA E GRAVA NOVA GERACAO
          //*           DO GDG. SO RODA SE O BACKUP TERMINOU COM RC 0.
          //*--------------------------------------------------------------------
        2 //STEP005  EXEC PGM=IEFBR14
        3 //BKPANT   DD DSN=&SYSUID..FATURA.TRANS.BKP,DISP=(MOD,DELETE),
          //            SPACE=(TRK,(1,1)),RECFM=FB,LRECL=80
        4 //APROVANT DD DSN=&SYSUID..FATURA.TRANS.APROV,DISP=(MOD,DELETE),
          //            SPACE=(TRK,(1,1)),RECFM=FB,LRECL=80
        5 //REJEIANT DD DSN=&SYSUID..FATURA.TRANS.REJEI,DISP=(MOD,DELETE),
          //            SPACE=(TRK,(1,1)),RECFM=FB,LRECL=120
          //*
        6 //STEP010  EXEC PGM=IEBGENER
        7 //SYSPRINT DD SYSOUT=*
        8 //SYSIN    DD DUMMY
        9 //SYSUT1   DD DSN=&SYSUID..FATURA.TRANS.DIA,DISP=SHR
       10 //SYSUT2   DD DSN=&SYSUID..FATURA.TRANS.BKP,DISP=(NEW,CATLG,DELETE),
          //            SPACE=(TRK,(5,5),RLSE),RECFM=FB,LRECL=80,BLKSIZE=0
          //*
       11 // IF (STEP010.RC = 0) THEN
       12 //STEP020  EXEC PGM=SORT
       13 //SYSOUT   DD SYSOUT=*
       14 //SORTIN   DD DSN=&SYSUID..FATURA.TRANS.DIA,DISP=SHR
       15 //SORTOUT  DD DSN=&SYSUID..FATURA.TRANS.ORDEN(+1),
          //            DISP=(NEW,CATLG,DELETE),
          //            SPACE=(TRK,(5,5),RLSE),RECFM=FB,LRECL=80,BLKSIZE=0
       16 //SYSIN    DD *
          /*
          //*
       17 // IF (STEP020.RC = 0) THEN
       18 //STEP030  EXEC PGM=FATFILTR
       19 //STEPLIB  DD DSN=&SYSUID..FATURA.LOAD,DISP=SHR
       20 //TRANSIN  DD DSN=&SYSUID..FATURA.TRANS.ORDEN(+1),DISP=SHR
       21 //APROVOUT DD DSN=&SYSUID..FATURA.TRANS.APROV,
          //            DISP=(NEW,CATLG,DELETE),
          //            SPACE=(TRK,(5,5),RLSE),RECFM=FB,LRECL=80,BLKSIZE=0
       22 //REJEIOUT DD DSN=&SYSUID..FATURA.TRANS.REJEI,
          //            DISP=(NEW,CATLG,DELETE),
          //            SPACE=(TRK,(5,5),RLSE),RECFM=FB,LRECL=120,BLKSIZE=0
          //*
       23 // IF (STEP030.RC <= 4) THEN
       24 //STEP040  EXEC PGM=FATRELAT
       25 //STEPLIB  DD DSN=&SYSUID..FATURA.LOAD,DISP=SHR
       26 //APROVIN  DD DSN=&SYSUID..FATURA.TRANS.APROV,DISP=SHR
       27 //MCCTAB   DD DSN=&SYSUID..FATURA.MCC.TABELA,DISP=SHR
       28 //RELATOUT DD DSN=&SYSUID..FATURA.RELAT,
          //            DISP=(NEW,CATLG,DELETE),
          //            SPACE=(TRK,(5,5),RLSE),
          //            DCB=(RECFM=FBA,LRECL=133,BLKSIZE=0)
       29 // ENDIF
       30 // ENDIF
       31 // ENDIF
