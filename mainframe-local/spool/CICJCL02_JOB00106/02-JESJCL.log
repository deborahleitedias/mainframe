        1 //CICJCL02 JOB ,'CICLO DO CARTAO',NOTIFY=&SYSUID,
          //             CLASS=A,MSGCLASS=X
          //*--------------------------------------------------------------------
          //* AULA 2 - AUTORIZACAO SIMULADA EM BATCH (CICAUTOR)
          //* GERA O LOG DE AUTORIZACOES E AS CONTAS COM OS LIMITES ATUALIZADOS.
          //* PODE SER SUBMETIDO VARIAS VEZES: O STEP005 APAGA AS SAIDAS.
          //*--------------------------------------------------------------------
        2 //STEP005  EXEC PGM=IEFBR14
        3 //LOGANT   DD DSN=&SYSUID..CICLO.AUTH.LOG,DISP=(MOD,DELETE),
          //            SPACE=(TRK,(1,1)),RECFM=FB,LRECL=120
        4 //CONANT   DD DSN=&SYSUID..CICLO.CONTAS.ATUAL,DISP=(MOD,DELETE),
          //            SPACE=(TRK,(1,1)),RECFM=FB,LRECL=80
          //*
        5 //STEP010  EXEC PGM=CICAUTOR
        6 //STEPLIB  DD DSN=&SYSUID..CICLO.LOAD,DISP=SHR
        7 //CONTAS   DD DSN=&SYSUID..CICLO.CONTAS,DISP=SHR
        8 //PEDIDOS  DD DSN=&SYSUID..CICLO.AUTH.PEDIDOS,DISP=SHR
        9 //LOGOUT   DD DSN=&SYSUID..CICLO.AUTH.LOG,
          //            DISP=(NEW,CATLG,DELETE),
          //            SPACE=(TRK,(2,1),RLSE),RECFM=FB,LRECL=120,BLKSIZE=0
       10 //CONTOUT  DD DSN=&SYSUID..CICLO.CONTAS.ATUAL,
          //            DISP=(NEW,CATLG,DELETE),
          //            SPACE=(TRK,(1,1),RLSE),RECFM=FB,LRECL=80,BLKSIZE=0
       11 //SYSOUT   DD SYSOUT=*
       12 //CEEDUMP  DD SYSOUT=*
