000105         9100-VALIDAR-LUHN.
000106             SET WS-LUHN-INVALIDO TO TRUE
000107             IF WS-LUHN-CARTAO IS NUMERIC
000108                MOVE ZERO TO WS-LUHN-SOMA
000109                SET WS-LUHN-NAO-DOBRA TO TRUE
000110                PERFORM VARYING WS-LUHN-POS FROM 16 BY -1
000111                        UNTIL WS-LUHN-POS < 1
000112                   MOVE WS-LUHN-DIGITO(WS-LUHN-POS)
000113                     TO WS-LUHN-PARCELA
000114                   IF WS-LUHN-DOBRA
000115                      COMPUTE WS-LUHN-PARCELA =
000116                         WS-LUHN-PARCELA * 2
000117                      IF WS-LUHN-PARCELA > 9
000118                         SUBTRACT 9 FROM WS-LUHN-PARCELA
000119                      END-IF
000120                      SET WS-LUHN-NAO-DOBRA TO TRUE
000121                   ELSE
000122                      SET WS-LUHN-DOBRA TO TRUE
000123                   END-IF
000124                   ADD WS-LUHN-PARCELA TO WS-LUHN-SOMA
000125                END-PERFORM
000126                IF FUNCTION MOD(WS-LUHN-SOMA, 10) = ZERO
000127                   SET WS-LUHN-VALIDO TO TRUE
000128                END-IF
000129             END-IF
000130             .


