000029             05  FILLER PIC X(31) VALUE
000030                 '990000073702838300000750000USAA'.
000031             05  FILLER PIC X(31) VALUE
000032                 '990000079819331600000020000BRAN'.
000033             05  FILLER PIC X(31) VALUE
000034                 '990000079819331700000020000BRAA'.
000035             05  FILLER PIC X(31) VALUE
