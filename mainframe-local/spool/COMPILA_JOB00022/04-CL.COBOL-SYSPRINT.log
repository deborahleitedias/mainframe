000053        *--- AREAS DO ALGORITMO DE LUHN ---------------------------------*
000054         01  WS-LUHN-CARTAO             PIC X(16).
000055         01  WS-LUHN-DIGITOS REDEFINES WS-LUHN-CARTAO.
000056             05  WS-LUHN-DIGITO         PIC 9(01) OCCURS 16 TIMES.
000057         01  WS-LUHN-POS                PIC 9(02).
000058         01  WS-LUHN-PARCELA            PIC 9(02).
000059         01  WS-LUHN-SOMA               PIC 9(03).
000060         01  WS-LUHN-DOBRAR             PIC X(01).
000061             88  WS-LUHN-DOBRA          VALUE 'S'.
000062             88  WS-LUHN-NAO-DOBRA      VALUE 'N'.
000063         01  WS-LUHN-RESULTADO          PIC X(01).
000064             88  WS-LUHN-VALIDO         VALUE 'S'.
000065             88  WS-LUHN-INVALIDO       VALUE 'N'.
000066
000067         PROCEDURE DIVISION.
000068         0000-PRINCIPAL.
000069             PERFORM 2100-CLASSIFICAR-TRANSACAO
000070                VARYING WS-IND FROM 1 BY 1
000071                UNTIL WS-IND > 6
000072             GOBACK.
000073
000074         2100-CLASSIFICAR-TRANSACAO.
000075             MOVE SPACES TO WS-CLASSIFICACAO
000076             MOVE WS-T-CARTAO(WS-IND) TO WS-LUHN-CARTAO
000077             PERFORM 9100-VALIDAR-LUHN
000078
000079             EVALUATE TRUE
000080                 WHEN WS-LUHN-INVALIDO
000081                     MOVE 'CARTAO INVALIDO'
000082                       TO WS-CLASSIFICACAO
000083
000084                 WHEN WS-T-NEGADA(WS-IND)
000085                     MOVE 'NEGADA'
000086                       TO WS-CLASSIFICACAO
000087
000088                 WHEN WS-T-APROVADA(WS-IND)
000089                  AND NOT WS-T-NACIONAL(WS-IND)
000090                  AND WS-T-VALOR(WS-IND) > WS-LIMITE-SUSPEITA
000091                     MOVE 'SUSPEITA'
000092                       TO WS-CLASSIFICACAO
000093
000094                 WHEN OTHER
000095                     MOVE 'APROVADA'
000096                       TO WS-CLASSIFICACAO
000097             END-EVALUATE
000098
000099             DISPLAY 'TRANSACAO ' WS-IND ': ' WS-CLASSIFICACAO
000100             .
