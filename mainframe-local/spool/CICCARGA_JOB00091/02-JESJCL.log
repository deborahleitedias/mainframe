        1 //CICCARGA JOB ,'CICLO DO CARTAO',NOTIFY=&SYSUID,
          //             CLASS=A,MSGCLASS=X
          //*--------------------------------------------------------------------
          //* CARGA DA MASSA FICTICIA DO CICLO DO CARTAO NOS DATASETS CRIADOS
