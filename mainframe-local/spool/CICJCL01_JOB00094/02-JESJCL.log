        1 //CICJCL01 JOB ,'CICLO DO CARTAO',NOTIFY=&SYSUID,
          //             CLASS=A,MSGCLASS=X
          //*--------------------------------------------------------------------
          //* AULA 1 - IDENTIFICACAO PELO BIN E DIVISAO DO VALOR (CICBIN)
          //* PODE SER SUBMETIDO VARIAS VEZES: O STEP005 APAGA O RELATORIO.
          //*--------------------------------------------------------------------
        2 //STEP005  EXEC PGM=IEFBR14
        3 //RELANT   DD DSN=&SYSUID..CICLO.RELBIN,DISP=(MOD,DELETE),
          //            SPACE=(TRK,(1,1)),RECFM=FBA,LRECL=133
          //*
        4 //STEP010  EXEC PGM=CICBIN
        5 //STEPLIB  DD DSN=&SYSUID..CICLO.LOAD,DISP=SHR
        6 //BINTAB   DD DSN=&SYSUID..CICLO.BIN.TABELA,DISP=SHR
        7 //PEDIDOS  DD DSN=&SYSUID..CICLO.AUTH.PEDIDOS,DISP=SHR
        8 //RELBIN   DD DSN=&SYSUID..CICLO.RELBIN,
          //            DISP=(NEW,CATLG,DELETE),
          //            SPACE=(TRK,(2,1),RLSE),RECFM=FBA,LRECL=133,BLKSIZE=0
        9 //SYSOUT   DD SYSOUT=*
       10 //CEEDUMP  DD SYSOUT=*
