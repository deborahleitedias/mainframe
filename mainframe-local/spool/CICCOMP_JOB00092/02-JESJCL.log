        1 //CICCOMP  JOB ,'CICLO DO CARTAO',NOTIFY=&SYSUID,
          //             CLASS=A,MSGCLASS=X
          //*--------------------------------------------------------------------
          //* COMPILA E LIGA UM PROGRAMA DO CICLO DO CARTAO.
          //* TROCAR O VALOR DE PGM NO SET ABAIXO PELO NOME DO MEMBRO.
          //*--------------------------------------------------------------------
        2 //         SET PGM=CICBIN
          //*
        3 //CL       EXEC IGYWCL
        4 //COBOL.SYSIN  DD DSN=&SYSUID..CICLO.COBOL(&PGM),DISP=SHR
        5 //COBOL.SYSLIB DD DSN=&SYSUID..CICLO.COPY,DISP=SHR
        6 //LKED.SYSLMOD DD DSN=&SYSUID..CICLO.LOAD(&PGM),DISP=SHR
