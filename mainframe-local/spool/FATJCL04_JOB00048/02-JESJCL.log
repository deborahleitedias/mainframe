        1 //FATJCL04 JOB ,'FATURA NOTURNA',NOTIFY=&SYSUID,
          //             CLASS=A,MSGCLASS=X
          //*--------------------------------------------------------------------
          //* AULA 4 - CHECKPOINT 2: JOB SO DE UTILITARIOS
          //*   STEP005 APAGA O BACKUP DO DIA ANTERIOR (SE EXISTIR)
          //*   STEP010 COPIA AS TRANSACOES PARA BACKUP (IEBGENER)
          //*   STEP020 ORDENA POR CARTAO, DATA E HORA E GRAVA NOVA GERACAO
          //*           DO GDG. SO RODA SE O BACKUP TERMINOU COM RC 0.
          //*--------------------------------------------------------------------
        2 //STEP005  EXEC PGM=IEFBR14
        3 //BKPANT   DD DSN=&SYSUID..FATURA.TRANS.BKP,DISP=(MOD,DELETE),
          //            SPACE=(TRK,(1,1)),RECFM=FB,LRECL=80
        4 //APROVANT DD DSN=&SYSUID..FATURA.TRANS.APROV,DISP=(MOD,DELETE),
          //            SPACE=(TRK,(1,1)),RECFM=FB,LRECL=80
        5 //REJEIANT DD DSN=&SYSUID..FATURA.TRANS.REJEI,DISP=(MOD,DELETE),
          //            SPACE=(TRK,(1,1)),RECFM=FB,LRECL=120
        6 //DIVANT   DD DSN=&SYSUID..FATURA.DIVERG,DISP=(MOD,DELETE),
          //            SPACE=(TRK,(1,1)),RECFM=FB,LRECL=80
        7 //RELANT   DD DSN=&SYSUID..FATURA.RELAT,DISP=(MOD,DELETE),
          //            SPACE=(TRK,(1,1)),RECFM=FBA,LRECL=133
        8 //STEP010  EXEC PGM=IEBGENER
        9 //SYSPRINT DD SYSOUT=*
       10 //SYSIN    DD DUMMY
       11 //SYSUT1   DD DSN=&SYSUID..FATURA.TRANS.DIA,DISP=SHR
       12 //SYSUT2   DD DSN=&SYSUID..FATURA.TRANS.BKP,DISP=(NEW,CATLG,DELETE),
          //            SPACE=(TRK,(5,5),RLSE),RECFM=FB,LRECL=80,BLKSIZE=0
          //*
       13 // IF (STEP010.RC = 0) THEN
       14 //STEP020  EXEC PGM=SORT
       15 //SYSOUT   DD SYSOUT=*
       16 //SORTIN   DD DSN=&SYSUID..FATURA.TRANS.DIA,DISP=SHR
       17 //SORTOUT  DD DSN=&SYSUID..FATURA.TRANS.ORDEN(+1),
          //            DISP=(NEW,CATLG,DELETE),
          //            SPACE=(TRK,(5,5),RLSE),RECFM=FB,LRECL=80,BLKSIZE=0
       18 //SYSIN    DD *
          /*
          //*
       19 // IF (STEP020.RC = 0) THEN
       20 //STEP030  EXEC PGM=FATFILTR
       21 //STEPLIB  DD DSN=&SYSUID..FATURA.LOAD,DISP=SHR
       22 //TRANSIN  DD DSN=&SYSUID..FATURA.TRANS.ORDEN(+1),DISP=SHR
       23 //APROVOUT DD DSN=&SYSUID..FATURA.TRANS.APROV,
          //            DISP=(NEW,CATLG,DELETE),
          //            SPACE=(TRK,(5,5),RLSE),RECFM=FB,LRECL=80,BLKSIZE=0
       24 //REJEIOUT DD DSN=&SYSUID..FATURA.TRANS.REJEI,
          //            DISP=(NEW,CATLG,DELETE),
          //            SPACE=(TRK,(5,5),RLSE),RECFM=FB,LRECL=120,BLKSIZE=0
          //*
       25 // IF (STEP030.RC <= 4) THEN
       26 //STEP040  EXEC PGM=FATRELAT
       27 //STEPLIB  DD DSN=&SYSUID..FATURA.LOAD,DISP=SHR
       28 //APROVIN  DD DSN=&SYSUID..FATURA.TRANS.APROV,DISP=SHR
       29 //MCCTAB   DD DSN=&SYSUID..FATURA.MCC.TABELA,DISP=SHR
       30 //RELATOUT DD DSN=&SYSUID..FATURA.RELAT,
          //            DISP=(NEW,CATLG,DELETE),
          //            SPACE=(TRK,(5,5),RLSE),
          //            DCB=(RECFM=FBA,LRECL=133,BLKSIZE=0)
          //*
       31 //STEP050  EXEC PGM=FATCONCI
       32 //STEPLIB  DD DSN=&SYSUID..FATURA.LOAD,DISP=SHR
       33 //FATIN    DD DSN=&SYSUID..FATURA.FATURAS.ABERTO,DISP=SHR
       34 //PAGIN    DD DSN=&SYSUID..FATURA.PAGTOS.DIA,DISP=SHR
       35 //DIVEROUT DD DSN=&SYSUID..FATURA.DIVERG,
          //            DISP=(NEW,CATLG,DELETE),
          //            SPACE=(TRK,(1,1),RLSE),RECFM=FB,LRECL=80,BLKSIZE=0
       36 //SYSOUT   DD SYSOUT=*
       37 //CEEDUMP  DD SYSOUT=*
       38 // ENDIF
       39 // ENDIF
       40 // ENDIF
