000338         2200-CONFERIR-VALOR.
000339        *    A ESCREVER (MAO NA MASSA): A REGRA DE TOLERANCIA DO PROJETO.
000340        *    MENOR QUE O AUTORIZADO: ACEITO. MAIOR: SO NO HOTEL (MCC 7011,
000341        *    15%) E NO RESTAURANTE (MCC 5812, ATE 20%). HOJE SO O VALOR IG
000342        *    PASSA: QUALQUER DIFERENCA VAI PARA A EXCECAO.
000343             IF CL-VALOR = LG-VALOR
000344                SET WS-VALOR-IGUAL TO TRUE
000345             ELSE
000346                IF CL-VALOR < LG-VALOR
000347                   SET WS-VALOR-ACEITO TO TRUE
000348                ELSE
000349                   EVALUATE CL-MCC
000350                      WHEN 7011
000351                         IF CL-VALOR <= LG-VALOR * 1.15
000352                            SET WS-VALOR-ACEITO TO TRUE
000353                         ELSE
000354                            SET WS-VALOR-FORA TO TRUE
000355                         END-IF
000356
000357                      WHEN 5812
000358                         IF CL-VALOR <= LG-VALOR * 1.20
000359                            SET WS-VALOR-ACEITO TO TRUE
000360                         ELSE
000361                            SET WS-VALOR-FORA TO TRUE
000362                         END-IF
000363
000364                      WHEN OTHER
000365                         SET WS-VALOR-FORA TO TRUE
000366                   END-EVALUATE
000367                END-IF
000368             END-IF
000369             .
