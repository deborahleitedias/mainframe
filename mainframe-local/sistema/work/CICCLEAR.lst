000272         2000-CASAR.
000273        *    A ESCREVER (AO VIVO): O BALANCE LINE ENTRE WS-CHAVE-AUT E
000274        *    WS-CHAVE-CLR. IGUAIS: SE A AUTORIZACAO JA FOI CASADA, 2400-
000275        *    DUPLICADA; SENAO, MARCAR CASADA E 2100-CASADA; LER SO A
000276        *    APRESENTACAO. AUT MENOR: SE LIVRE, 2500-SEM-APRESENTACAO; LIB
000277        *    E LER A AUTORIZACAO. CLR MENOR: 2300-SEM-AUTORIZACAO E LER A
000278        *    APRESENTACAO. ENQUANTO ISSO NAO EXISTE, O PROGRAMA TERMINA NA
000279        *    PRIMEIRA VOLTA, COM RC 16 (CLASSES NAO FECHAM).
000280             EVALUATE TRUE
000281                WHEN WS-CHAVE-AUT = WS-CHAVE-CLR
000282                   IF WS-AUTORIZACAO-CASADA
000283                      PERFORM 2400-DUPLICADA THRU 2400-FIM-DUPLICADA
000284                   ELSE
000285                      SET WS-AUTORIZACAO-CASADA TO TRUE
000286                      PERFORM 2100-CASADA THRU 2100-FIM-CASADA
000287                   END-IF
000288                   PERFORM 8200-LER-APRESENTACAO
000289                      THRU 8200-FIM-LER-APRESENTACAO
000290                WHEN WS-CHAVE-AUT < WS-CHAVE-CLR
000291                   IF WS-AUTORIZACAO-LIVRE
000292                      PERFORM 2500-SEM-APRESENTACAO
000293                      THRU 2500-FIM-SEM-APRESENTACAO
000294                   END-IF
000295                   SET WS-AUTORIZACAO-LIVRE TO TRUE
000296                   PERFORM 8100-LER-AUTORIZACAO
000297                      THRU 8100-FIM-LER-AUTORIZACAO
000298                WHEN OTHER
000299                   PERFORM 2300-SEM-AUTORIZACAO
000300                      THRU 2300-FIM-SEM-AUTORIZACAO
000301                   PERFORM 8200-LER-APRESENTACAO
000302                      THRU 8200-FIM-LER-APRESENTACAO
000303             END-EVALUATE.
000304
000305         2000-FIM-CASAR.
000306             EXIT.
000307
000308         2100-CASADA.
000309             PERFORM 2200-CONFERIR-VALOR THRU 2200-FIM-CONFERIR-VALOR
000310             EVALUATE TRUE
000311                WHEN WS-VALOR-IGUAL
000312                   ADD 1 TO WS-QTD-CASADAS
000313                   PERFORM 7000-MONTAR-LANCAMENTO
000314                      THRU 7000-FIM-MONTAR-LANCAMENTO
000315                   PERFORM 7050-GRAVAR-LANCAMENTO
000316                      THRU 7050-FIM-GRAVAR-LANCAMENTO
000317                WHEN WS-VALOR-ACEITO
GnuCOBOL 3.3-dev.0      sistema\work\CICCLEA Mon Nov 23 2026 17:09:02  Page 0010

LINE    PG/LN  A...B............................................................

000318                   ADD 1 TO WS-QTD-DIF-ACEITA
000319                   PERFORM 7000-MONTAR-LANCAMENTO
000320                      THRU 7000-FIM-MONTAR-LANCAMENTO
000321                   SET LC-DIFERENCA-ACEITA TO TRUE
000322                   PERFORM 7050-GRAVAR-LANCAMENTO
000323                      THRU 7050-FIM-GRAVAR-LANCAMENTO
000324                WHEN WS-VALOR-FORA
000325        *          NAO LANCA: A DIFERENCA VAI PARA ANALISE
000326                   ADD 1 TO WS-QTD-DIF-FORA
000327                   MOVE SPACES TO REG-EXCECAO
000328                   SET EX-DIFERENCA-FORA TO TRUE
000329                   MOVE 'VALOR APRESENTADO FORA DA TOLERANCIA'
000330                                         TO EX-DESCRICAO
000331                   PERFORM 7100-GRAVAR-EXCECAO-CLR
000332                      THRU 7100-FIM-GRAVAR-EXCECAO-CLR
000333             END-EVALUATE
000334             .
