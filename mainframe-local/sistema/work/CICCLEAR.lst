000240                     WS-DATA-PROCESSAMENTO
000241
000242             PERFORM VARYING IX-CTL FROM 1 BY 1
000243                     UNTIL IX-CTL > 2
000244
000245                DISPLAY 'BANDEIRA: '
000246                        WS-CTL-BANDEIRA(IX-CTL)
000247
000248                DISPLAY 'QTD. DETALHES: '
000249                        WS-CTL-QTD-DET(IX-CTL)
