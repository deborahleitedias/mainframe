GnuCOBOL 3.3-dev.0      sistema\work\CICCLEA Wed Nov 18 2026 21:49:55  Page 0008

LINE    PG/LN  A...B............................................................

000214                         AT END
000215                            DISPLAY 'CICCLEAR - BANDEIRA DESCONHECIDA: '
000216                                    CL-BANDEIRA
000217                            SET WS-TOTAIS-ERRADOS TO TRUE
000218                         WHEN WS-CTL-BANDEIRA(IX-CTL) = CL-BANDEIRA
000219                            ADD 1        TO WS-CTL-QTD-DET(IX-CTL)
000220                            ADD CL-VALOR TO WS-CTL-VALOR-DET(IX-CTL)
000221                      END-SEARCH
000222                   WHEN CL-TRAILER
000223                      SET IX-CTL TO 1
000224                      SEARCH WS-CTL-ITEM
000225                         AT END
000226                            SET WS-TOTAIS-ERRADOS TO TRUE
000227                         WHEN WS-CTL-BANDEIRA(IX-CTL) = CL-T-BANDEIRA
000228                            MOVE CL-T-QTD   TO WS-CTL-QTD-TRL(IX-CTL)
000229                            MOVE CL-T-VALOR TO WS-CTL-VALOR-TRL(IX-CTL)
000230                            MOVE 'S'        TO WS-CTL-TEM-TRAILER(IX-CTL)
000231                      END-SEARCH
000232                END-EVALUATE
000233                READ CLEARING
000234             END-PERFORM
