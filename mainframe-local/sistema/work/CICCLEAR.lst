000134
000135         PROCEDURE DIVISION.
000136         0000-PRINCIPAL.
000137             PERFORM 1000-INICIALIZAR THRU 1000-FIM-INICIALIZAR
000138             PERFORM 2000-CASAR       THRU 2000-FIM-CASAR
000139                UNTIL WS-CHAVE-AUT = HIGH-VALUES
000140                  AND WS-CHAVE-CLR = HIGH-VALUES
000141             PERFORM 3000-FINALIZAR   THRU 3000-FIM-FINALIZAR
000142             STOP RUN.
000143
000144         1000-INICIALIZAR.
000145        *    PRIMEIRA PASSADA: SO CONFERE OS TOTAIS DE CONTROLE
000146             PERFORM 1100-CONFERIR-TRAILERS
000147                THRU 1100-FIM-CONFERIR-TRAILERS
000148             IF WS-TOTAIS-ERRADOS
000149                DISPLAY 'CICCLEAR - TOTAIS DO TRAILER NAO CONFEREM: '
000150                        'ARQUIVO NAO PROCESSADO'
000151                MOVE 8 TO RETURN-CODE
000152                STOP RUN
000153             END-IF
000154
000155        *    SEGUNDA PASSADA: O PROCESSAMENTO
000156             OPEN INPUT CLEARING
000157             IF NOT WS-FS-CLR-OK
000158                DISPLAY 'CICCLEAR - ERRO DE OPEN CLEARIN FS: '
000159                        WS-FS-CLEARING
000160                PERFORM 9900-ENCERRAR-COM-ERRO
000161             END-IF
