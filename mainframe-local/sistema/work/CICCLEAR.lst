000202             IF NOT WS-FS-CLR-OK
000203                DISPLAY 'CICCLEAR - ERRO DE OPEN CLEARIN FS: '
000204                        WS-FS-CLEARING
000205                PERFORM 9900-ENCERRAR-COM-ERRO
000206             END-IF
000207             READ CLEARING
000208             PERFORM UNTIL WS-FS-CLR-FIM
000209                EVALUATE TRUE
000210                   WHEN CL-HEADER
000211                      MOVE CL-H-DATA-PROC TO WS-DATA-PROCESSAMENTO
000212                   WHEN CL-DETALHE
000213                      SET IX-CTL TO 1
GnuCOBOL 3.3-dev.0      sistema\work\CICCLEA Mon Nov 23 2026 17:09:02  Page 0008

LINE    PG/LN  A...B............................................................

000214                      SEARCH WS-CTL-ITEM
000215                         AT END
000216                            DISPLAY 'CICCLEAR - BANDEIRA DESCONHECIDA: '
000217                                    CL-BANDEIRA
000218                            SET WS-TOTAIS-ERRADOS TO TRUE
000219                         WHEN WS-CTL-BANDEIRA(IX-CTL) = CL-BANDEIRA
000220                            ADD 1        TO WS-CTL-QTD-DET(IX-CTL)
000221                            ADD CL-VALOR TO WS-CTL-VALOR-DET(IX-CTL)
000222                      END-SEARCH
000223                   WHEN CL-TRAILER
000224                      SET IX-CTL TO 1
000225                      SEARCH WS-CTL-ITEM
000226                         AT END
000227                            SET WS-TOTAIS-ERRADOS TO TRUE
000228                         WHEN WS-CTL-BANDEIRA(IX-CTL) = CL-T-BANDEIRA
000229                            MOVE CL-T-QTD   TO WS-CTL-QTD-TRL(IX-CTL)
000230                            MOVE CL-T-VALOR TO WS-CTL-VALOR-TRL(IX-CTL)
000231                            MOVE 'S'        TO WS-CTL-TEM-TRAILER(IX-CTL)
000232                      END-SEARCH
000233                END-EVALUATE
000234                READ CLEARING
000235             END-PERFORM
000236             CLOSE CLEARING
000237
000238        *    CONFERENCIA DOS TOTAIS DAS BANDEIRAS
