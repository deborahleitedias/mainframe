000356         2500-REVERTER.
000357        *    0400 (ESTORNO A PEDIDO OU REVERSAO POR TIME-OUT) E 0420
000358        *    (AVISO DE REVERSAO): PROCURA A AUTORIZACAO ORIGINAL PELO
000359        *    CARTAO E PELO CODIGO DE AUTORIZACAO
000360             IF PD-REVERSAO
000361                MOVE '0410' TO LG-MTI-RESPOSTA
000362             ELSE
000363                MOVE '0430' TO LG-MTI-RESPOSTA
000364             END-IF
000365             MOVE PD-COD-AUT-ORIGINAL TO LG-COD-AUTORIZACAO
000366             SET WS-ORIGINAL-NAO-ENCONTRADA TO TRUE
000367             PERFORM VARYING IX-AP FROM 1 BY 1
000368                     UNTIL IX-AP > WS-QTD-AP OR WS-ORIGINAL-ENCONTRADA
000369                IF WS-AP-CARTAO(IX-AP)    = PD-NUM-CARTAO
000370               AND WS-AP-CODIGO(IX-AP)    = PD-COD-AUT-ORIGINAL
000371               AND WS-AP-REVERTIDA(IX-AP) = 'N'
000372                   SET WS-ORIGINAL-ENCONTRADA TO TRUE
000373                   SET IX-LOG TO WS-AP-POSICAO-LOG(IX-AP)
000374                   MOVE 'S' TO WS-AP-REVERTIDA(IX-AP)
000375                   IF WS-CONTA-ENCONTRADA
000376                      ADD WS-AP-VALOR(IX-AP) TO WS-CT-DISP(IX-CT)
000377                   END-IF
000378                END-IF
000379             END-PERFORM
000380             IF WS-ORIGINAL-ENCONTRADA
