000042         PROCEDURE DIVISION.
000043
000044         0000-PRINCIPAL.
000045             PERFORM 1000-INICIALIZAR THRU 1000-FIM-INICIALIZAR
000046             PERFORM 2000-PROCESSAR THRU 2000-FIM-PROCESSAR
000047             PERFORM 3000-FINALIZAR THRU 3000-FIM-FINALIZAR
000048             STOP RUN.
000049
000050         1000-INICIALIZAR.
000051             OPEN INPUT DIVERGENCIA
000052
000053             IF WS-FS NOT = '00'
000054                 DISPLAY 'ERRO NO OPEN: ' WS-FS
000055                 STOP RUN
000056             END-IF.
000057
000058         1000-FIM-INICIALIZAR.
000059             EXIT.
000060
000061         2000-PROCESSAR.
000062             PERFORM UNTIL WS-FS = '10'
000063
000064                 READ DIVERGENCIA
000065                     AT END
000066                         CONTINUE
000067                     NOT AT END
000068                         MOVE FD-REGISTRO TO REG-DIVERGENCIA
000069
000070                         PERFORM 2100-CLASSIFICAR
000071                             THRU 2100-FIM
000072                 END-READ
000073
000074                 IF WS-FS NOT = '00' AND WS-FS NOT = '10'
000075                     DISPLAY 'ERRO NO READ: ' WS-FS
000076                     STOP RUN
000077                 END-IF
000078
000079             END-PERFORM.
000080
000081         2000-FIM-PROCESSAR.
000082             EXIT.
000083
000084         2100-CLASSIFICAR.
000085             EVALUATE TRUE
000086
000087                 WHEN DV-PAGTO-SEM-FATURA
